{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/leonard/.config/fastfetch/ascii.txt",
    "type": "file",
    "color": {
      "1": "38;2;136;192;208"
    }
  },
  "display": {
    "separator": " → ",
    "color": {
      "keys": "38;2;136;192;208",
      "title": "38;2;143;188;187",
      "separator": "38;2;76;86;106"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "custom",
      "format": "┌─────── System ───────",
      "outputColor": "38;2;76;86;106"
    },
    {
      "type": "custom",
      "format": "{#keys}│ ├ OS:{#} Debian (Trixie) BTW"
    },
    {
      "type": "uptime",
      "key": "│ ├󰥔 Uptime"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖 Packages"
    },
    {
      "type": "shell",
      "key": "│ ├ Shell"
    },
    {
      "type": "wm",
      "key": "│ └󰖯 WM"
    },
    {
      "type": "custom",
      "format": "└────────────────────────",
      "outputColor": "38;2;76;86;106"
    }
  ]
}
